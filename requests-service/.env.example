NB_URL=http://localhost:13000
NB_SERVICE_USER=requests-service
NB_SERVICE_PASSWORD=
ALLOWED_ORIGINS=http://<адрес CRM в офисе>:13000,https://<домен CRM>
# портал арендатора: адрес (ссылки в письмах и личные ссылки), секрет подписи входа (openssl rand -hex 32)
PORTAL_URL=https://help.<домен>/
PORTAL_SECRET=
# ящик для писем арендаторам (коды входа, ответы, статусы); пусто — вход только по личной ссылке, писем нет
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
