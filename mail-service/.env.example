# адрес NocoBase, через который сервис проверяет сессию сотрудника
NB_URL=http://nocobase-host:13000
# откуда разрешены запросы (адрес NocoBase в браузере), через запятую
ALLOWED_ORIGINS=http://nocobase-host:13000
# почтовый домен и (для пилота) список адресов; пусто — все адреса домена
MAIL_DOMAIN=example.ru
MAIL_USERS=
IMAP_HOST=imap.example.ru
IMAP_PORT=993
SMTP_HOST=smtp.example.ru
SMTP_PORT=465
# ключ шифрования паролей от ящиков: openssl rand -hex 32 (не менять — иначе сохранённые пароли придётся вводить заново)
MAIL_KEY=
