# Telegram-мост CRM (scripts/tg_bridge.py). Установка на svc:
#   cp scripts/tg_bridge.py ~/nb_bik/ && sudo cp deploy/crm-telegram.service /etc/systemd/system/
#   ~/nb_bik/tg.env: TG_TOKEN=..., CRM_URL=https://crm.ykinvest.ru (chmod 600)
#   sudo systemctl enable --now crm-telegram; журнал — journalctl -u crm-telegram
[Unit]
Description=CRM -> Telegram notifications bridge
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=ubuntu
EnvironmentFile=/home/ubuntu/nb_bik/tg.env
ExecStart=/usr/bin/python3 -u /home/ubuntu/nb_bik/tg_bridge.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
